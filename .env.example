# Production
APP_ENV=production
FLASK_SECRET_KEY=REPLACE_WITH_A_RANDOM_48_PLUS_CHARACTER_SECRET
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
MAX_CONTENT_LENGTH_MB=8
DATABASE_PATH=/opt/hcmute-ars/database.db
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# MQTT
MQTT_BROKER=
MQTT_PORT=8883
MQTT_TOPIC=class/quiz/answer
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_INSECURE=0

# Password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
RESET_OTP_CONSOLE=0
